{
  "name": "quanttrade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Start-QuantTrade.ps1",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Start-QuantTrade.ps1",
    "build": "npm run typecheck && powershell -NoProfile -ExecutionPolicy Bypass -File ./Start-QuantTrade.ps1 -BuildOnly",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Start-QuantTrade.ps1",
    "start:server": "tsx src/server/index.ts",
    "test": "node --experimental-transform-types --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pairlens/fast-financial-charts": "2.2.0",
    "decimal.js": "10.6.0",
    "express": "5.1.0",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
