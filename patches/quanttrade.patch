+/** Recorded coverage starts at the later of the requested window and collector startup. */
+export function liquidationCoverageStart(
+  data:
+    | Pick<LiquidationClustersResponse, 'trackedSince' | 'fetchedAt'>
+    | null
+    | undefined,
+  hours: number,
+): number | null {
+  if (!data || !Number.isFinite(data.trackedSince)) return null
+  const fetchedAt = Date.parse(data.fetchedAt)
+  if (!Number.isFinite(fetchedAt)) return null
+  return Math.max(fetchedAt - hours * 3_600_000, data.trackedSince)
+}
