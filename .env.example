# Default stays paper. Restart the server after changing configuration.
DESK_MODE=paper
MAX_ORDER_NOTIONAL=1000
DAILY_NOTIONAL_LIMIT=5000
MAX_PRICE_DEVIATION_BPS=100
PROPOSAL_TTL_SECONDS=120

# Configure accounts and exchange signing keys in your local Hummingbot API.
# These are the API service login, never a wallet private key.
HUMMINGBOT_URL=http://127.0.0.1:8000
HUMMINGBOT_USERNAME=
HUMMINGBOT_PASSWORD=
HUMMINGBOT_ACCOUNT=desk

# Optional chat-completions compatible provider, or local model server.
# The base URL includes /v1 if your provider requires it.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
PAIRLENS_URL=http://localhost:4317
# For an HTTPS deployment, supply its exact origin. Separate additional origins with commas.
ALLOWED_ORIGINS=
# Hosted browser session: generated by deployment; the proxy secret is server-only.
WEB_SESSION_ORIGIN=
WEB_SESSION_PROXY_SECRET=
