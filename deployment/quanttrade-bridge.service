[Unit]
Description=QuantTrade approved-trade bridge
After=network-online.target
Wants=network-online.target

[Service]
User=quanttrade
Group=quanttrade
WorkingDirectory=/opt/quanttrade/shared
EnvironmentFile=/opt/quanttrade/shared/bridge.env
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node --experimental-transform-types /opt/quanttrade/current/src/server/index.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/quanttrade/shared/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
